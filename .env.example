# Copy this file to .env and adjust values before running in production
PORT=4400
SESSION_SECRET=change-this-to-a-long-random-string

# Seed admin account (created automatically the first time the server runs
# if data/users.json is empty). Change the password after first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
