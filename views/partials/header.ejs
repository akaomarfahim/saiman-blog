<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SAIMAN BLOG</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23111827'/><text x='50%' y='50%' dominant-baseline='central' text-anchor='middle' font-family='sans-serif' font-size='68' font-weight='900' fill='%23ffffff'>S</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <!-- Decorative ambient gradient blobs, purely visual -->
  <div class="ambient-bg" aria-hidden="true">
    <span class="orb orb-1"></span>
    <span class="orb orb-2"></span>
    <span class="orb orb-3"></span>
  </div>

  <header class="site-header" id="siteHeader">
    <div class="shell header-inner">
      <a href="/" style="color: green;" class="brand">
        <span class="brand-mark">&#9679;</span>
        SAIMAN BLOG
      </a>
      <nav class="nav">
        <a href="/">Home</a>
        <% if (currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin">Dashboard</a>
          <% } %>
          <span class="nav-user">Hi, <%= currentUser.username %></span>
          <form action="/logout" method="POST" class="inline-form">
            <button type="submit" class="link-button">Log out</button>
          </form>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/register" class="btn btn-small no-underline" style="padding-inline: 24px;">Sign up</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="shell">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>"><%= flash.message %></div>
    <% } %>
