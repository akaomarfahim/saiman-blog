<%- include('../partials/header') %>

<section class="auth-form-wrap post-form-wrap reveal">
  <h1><%= post ? 'Edit post' : 'New post' %></h1>

  <% if (errors.length > 0) { %>
    <ul class="error-list">
      <% errors.forEach(function(err) { %><li><%= err %></li><% }) %>
    </ul>
  <% } %>

  <form action="<%= post ? '/admin/edit/' + post.id : '/admin/new' %>" method="POST" enctype="multipart/form-data" class="auth-form">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required />

    <label for="excerpt">Excerpt <span class="hint">(optional short summary shown on the homepage)</span></label>
    <input type="text" id="excerpt" name="excerpt" value="<%= post ? post.excerpt : '' %>" />

    <label for="image">Featured image <span class="hint">(JPG, PNG, WEBP, or GIF, up to 5MB)</span></label>
    <% if (post && post.imageUrl) { %>
      <div class="current-image-preview">
        <img src="<%= post.imageUrl %>" alt="Current featured image" />
        <label class="checkbox-label">
          <input type="checkbox" name="removeImage" /> Remove this image
        </label>
      </div>
    <% } %>
    <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />

    <label for="content">Content</label>
    <textarea id="content" name="content" rows="16" required><%= post ? post.content : '' %></textarea>

    <button type="submit" class="btn btn-full"><%= post ? 'Save changes' : 'Publish post' %></button>
  </form>
</section>

<%- include('../partials/footer') %>
