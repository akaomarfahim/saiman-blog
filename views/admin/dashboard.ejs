<%- include('../partials/header') %>

<section class="admin-dashboard reveal">
  <div class="admin-dashboard-header">
    <h1>Dashboard</h1>
    <a href="/admin/new" class="btn">+ New post</a>
  </div>

  <% if (posts.length === 0) { %>
    <p class="empty-state">You haven't published anything yet.</p>
  <% } else { %>
    <div class="admin-post-list">
      <% posts.forEach(function(post) { %>
        <div class="admin-post-row">
          <% if (post.imageUrl) { %>
            <img src="<%= post.imageUrl %>" alt="" class="admin-thumb" />
          <% } else { %>
            <div class="admin-thumb placeholder-gradient"><span><%= post.title.charAt(0) %></span></div>
          <% } %>
          <div class="admin-post-info">
            <a href="/post/<%= post.slug %>" class="admin-post-title"><%= post.title %></a>
            <span class="post-meta"><%= new Date(post.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
          </div>
          <div class="admin-table-actions">
            <a href="/admin/edit/<%= post.id %>" class="btn btn-small btn-outline">Edit</a>
            <form action="/admin/delete/<%= post.id %>" method="POST" class="inline-form" onsubmit="return confirm('Delete this post and all its comments?');">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
